{
    "name": "rse-sa/delivra",
    "description": "Easy Notifications Delivery",
    "license": "MIT",
    "type": "library",
    "keywords": ["laravel", "sms", "telegram", "whatsapp", "notifications"],
    "authors": [
        {
            "name": "Muhannad A",
            "email": "malhussain@rse.sa"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": ">=10.0",
        "illuminate/http": ">=10.0",
        "illuminate/notifications": ">=10.0",
        "illuminate/routing": ">=10.0",
        "illuminate/cache": ">=10.0",
        "illuminate/console": ">=10.0",
        "guzzlehttp/guzzle": "^7.0",
        "nesbot/carbon": "^2.0|^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": ">=9.0",
        "mockery/mockery": "^1.2",
        "orchestra/testbench": ">=6.0"
    },
    "autoload": {
        "files": [
            "src/Helpers.php"
        ],
        "psr-4": {
            "RSE\\Delivra\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RSE\\Delivra\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RSE\\Delivra\\DelivraServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
